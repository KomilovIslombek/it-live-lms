{
  "info": {
    "name": "IT Live LMS API",
    "description": "Requests for the IT Live LMS Express API, with tests on every request.\n\nSetup: import this collection and `local.postman_environment.json`, select the **IT Live LMS (local)** environment, and fill in `adminPhone` and `adminPassword` (the values from `server/.env`) as *current values*. Start the database (`docker compose up -d`) and the server (`cd server && npm run dev`).\n\nRun the whole collection with **Run collection**, or send requests one by one. Postman keeps the login cookie like a browser does, so **Login** must run before **Me**.\n\nSource of truth: `postman/it-live-lms.postman_collection.json` in https://github.com/KomilovIslombek/it-live-lms",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health",
            "description": "Is the server up, and can it reach the database? 200 when both are fine, 503 when the database is unreachable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Server and database are ok\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql(\"ok\");",
                  "  pm.expect(body.database).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{adminPhone}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Logs in with phone (+998 and 9 digits) and password, like the Figma login screen. On success the server sets an httpOnly cookie named `token` (a JWT valid for 1 day) and returns the user without the password hash."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the user without the password hash\", () => {",
                  "  const { user } = pm.response.json();",
                  "  pm.expect(user).to.include.keys(\"id\", \"phone\", \"full_name\", \"status\", \"role\");",
                  "  pm.expect(user).to.not.have.property(\"password_hash\");",
                  "});",
                  "pm.test(\"Sets the token cookie\", () => {",
                  "  pm.expect(pm.cookies.has(\"token\")).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (logged in)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Who am I? Uses the `token` cookie that **Login** stored, so run Login first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the logged-in user\", () => {",
                  "  const { user } = pm.response.json();",
                  "  pm.expect(user.phone).to.eql(pm.environment.get(\"adminPhone\"));",
                  "  pm.expect(user).to.not.have.property(\"password_hash\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me without a cookie → 401",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Cookies are turned off for this request (Settings tab → Disable cookie jar), so it behaves like a visitor who never logged in."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Error says not logged in\", () => {",
                  "  pm.expect(pm.response.json().error).to.match(/not logged in/i);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me with an invalid token → 401",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "token=not-a-real-token"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Sends a fake token. The signature check fails, so the server answers 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Error says the session is invalid\", () => {",
                  "  pm.expect(pm.response.json().error).to.eql(\"Session expired or invalid\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Deletes the `token` cookie. Answers 204 No Content, even when nobody was logged in."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));",
                  "pm.test(\"Removes the token cookie\", () => {",
                  "  pm.expect(pm.cookies.has(\"token\")).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me after logout → 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Same request as Me (logged in), right after Logout: the cookie is gone, so the answer is 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Login with a wrong password → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{adminPhone}}\",\n  \"password\": \"definitely-the-wrong-password\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Same message as an unknown phone\", () => {",
                  "  pm.expect(pm.response.json().error).to.eql(\"Invalid phone or password\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with an unknown phone → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+998000000000\",\n  \"password\": \"whatever123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Same message as a wrong password\", () => {",
                  "  pm.expect(pm.response.json().error).to.eql(\"Invalid phone or password\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with an invalid body → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"12345\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Explains each wrong field\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql(\"Invalid request\");",
                  "  pm.expect(body.details).to.have.keys(\"phone\", \"password\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Broken JSON → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{bad"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "The body isn't valid JSON. The error handler must answer with JSON, not Express's HTML error page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Answers with JSON, not HTML\", () => {",
                  "  pm.response.to.be.json;",
                  "  pm.expect(pm.response.json().error).to.eql(\"Invalid JSON\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route → 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/does-not-exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Answers with JSON\", () => {",
                  "  pm.expect(pm.response.json().error).to.eql(\"Not found\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Admin-only routes (/api/v1/admin/...). Every request here needs the admin's cookie, so the folder starts with a login. The test data it creates is deleted again in Cleanup.",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{adminPhone}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "description": "The Auth folder ends with Logout, so log in again. Also picks a runId (the current time) so the test data has unique names on every run."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Logged in as admin\", () => pm.expect(pm.response.json().user.role).to.eql(\"admin\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Users",
          "item": [
            {
              "name": "List users",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/v1/admin/users"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test(\"Has users, page, limit and total\", () => {",
                      "  pm.expect(body.users).to.be.an(\"array\");",
                      "  pm.expect(body.page).to.eql(1);",
                      "  pm.expect(body.limit).to.eql(10);",
                      "  pm.expect(body.total).to.be.at.least(1);",
                      "});",
                      "pm.test(\"No password hashes\", () => body.users.forEach((u) => pm.expect(u).to.not.have.property(\"password_hash\")));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "List users by role",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/v1/admin/users?role=admin"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                      "pm.test(\"Only admins\", () => pm.response.json().users.forEach((u) => pm.expect(u.role).to.eql(\"admin\")));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Search users by phone",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/v1/admin/users?search={{adminPhone}}",
                "description": "Search looks at the name and the phone. + in a URL means a space, so the pre-request script encodes it."
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.request.url.query.upsert({ key: \"search\", value: encodeURIComponent(pm.environment.get(\"adminPhone\")) });"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                      "pm.test(\"Finds the admin\", () => {",
                      "  const phones = pm.response.json().users.map((u) => u.phone);",
                      "  pm.expect(phones).to.include(pm.environment.get(\"adminPhone\"));",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "List users with a small page",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/v1/admin/users?page=1&limit=1"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                      "pm.test(\"At most 1 user\", () => pm.expect(pm.response.json().users.length).to.be.at.most(1));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "List users with an unknown role → 400",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/v1/admin/users?role=boss"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                      "pm.test(\"Explains the role field\", () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.error).to.eql(\"Invalid request\");",
                      "  pm.expect(body.details).to.have.property(\"role\");",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "List users with page=0 → 400",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/v1/admin/users?page=0"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                      "pm.test(\"Explains the page field\", () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.error).to.eql(\"Invalid request\");",
                      "  pm.expect(body.details).to.have.property(\"page\");",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Categories",
          "item": [
            {
              "name": "Create category",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/v1/admin/categories",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Test category {{runId}}\",\n  \"description\": \"Created by the Postman tests\"\n}"
                },
                "description": "No slug sent, so the server makes one from the title."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                      "const { category } = pm.response.json();",
                      "pm.test(\"Slug is made from the title\", () => pm.expect(category.slug).to.eql(\"test-category-\" + pm.collectionVariables.get(\"runId\")));",
                      "pm.test(\"Active by default, no courses yet\", () => {",
                      "  pm.expect(category.status).to.be.true;",
                      "  pm.expect(category.courses_count).to.eql(0);",
                      "});",
                      "pm.collectionVariables.set(\"categoryId\", category.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Create category with a taken slug → 409",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/v1/admin/categories",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Another title\",\n  \"slug\": \"test-category-{{runId}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                      "pm.test(\"Error message\", () => pm.expect(pm.response.json().error).to.eql(\"A category with this slug already exists\"));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Create category without a title → 400",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/v1/admin/categories",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                      "pm.test(\"Explains the title field\", () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.error).to.eql(\"Invalid request\");",
                      "  pm.expect(body.details).to.have.property(\"title\");",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Create category with a bad slug → 400",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/v1/admin/categories",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Bad slug\",\n  \"slug\": \"Bad Slug!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                      "pm.test(\"Explains the slug field\", () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.error).to.eql(\"Invalid request\");",
                      "  pm.expect(body.details).to.have.property(\"slug\");",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "List categories",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/v1/admin/categories"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                      "pm.test(\"Contains the new category\", () => {",
                      "  const ids = pm.response.json().categories.map((c) => c.id);",
                      "  pm.expect(ids).to.include(pm.collectionVariables.get(\"categoryId\"));",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get category",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                      "pm.test(\"Same id\", () => pm.expect(pm.response.json().category.id).to.eql(pm.collectionVariables.get(\"categoryId\")));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get category with an invalid id → 400",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/v1/admin/categories/abc"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                      "pm.test(\"Error message\", () => pm.expect(pm.response.json().error).to.eql(\"Invalid id\"));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get unknown category → 404",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/v1/admin/categories/2147483647"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                      "pm.test(\"Error message\", () => pm.expect(pm.response.json().error).to.eql(\"Category not found\"));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Update category",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"description\": \"Updated by the Postman tests\",\n  \"status\": false\n}"
                },
                "description": "PATCH changes only the fields that are sent."
              },
              "event": [
                {
