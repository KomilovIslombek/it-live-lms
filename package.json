{
  "name": "it-live-lms",
  "version": "1.0.0",
  "description": "A learning management system for an online IT school. Admins build courses (sections → lessons → materials, assignments and exams), mentors teach and grade, and students learn and track their progress.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "start": "npm --prefix server start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KomilovIslombek/it-live-lms.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/KomilovIslombek/it-live-lms/issues"
  },
  "homepage": "https://github.com/KomilovIslombek/it-live-lms#readme",
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "3.9.10"
  }
}
